# Copy to .env and fill in. Never commit .env.

# Token from BotFather for @AsereVoyBot.
TELEGRAM_TOKEN=

# Comma-separated Telegram user ids. Superadmins are only defined here.
SUPERADMIN_IDS=

# Numeric id of the offers channel (usually starts with -100).
OFFERS_CHANNEL_ID=

# Encrypts drivers' phones in the database: 32 bytes in hex (openssl rand -hex 32).
# Losing it makes the stored phones unreadable.
PHONE_KEY=

# Fingerprints client-driver pairs so they can't farm ratings: 32 bytes in hex.
PAIR_KEY=

# Telegram account that answers support (e.g. AsereVoySoporte, without @).
# Turn on its auto-delete timer for new chats (Settings > Privacy).
SUPPORT_USERNAME=

DATABASE_URL=sqlite://aserevoy.db

# Own OSRM instance (see docs/diseno.md, "Ubicación y precio").
OSRM_URL=http://localhost:5000

# Optional: Jev (TypeSafe) to interpret typed addresses.
JEV_ENABLED=false

# Streets, corners and places of La Habana (built by scripts/prepare_osm.py).
STREETS_DB=data/streets.sqlite
TYPESAFE_API_KEY=

# Initial fares in CUP, copied to the database on first start.
# Afterwards superadmins change them from the bot.
FARE_BASE=100
FARE_PER_KM=150
FARE_MIN_PERCENT=80

# Docker only: version of the published image (ghcr.io/forte11cuba/aserevoy),
# e.g. 0.1.0. Empty means the latest version.
ASEREVOY_VERSION=

# Log level, e.g. aserevoy=debug
RUST_LOG=aserevoy=info
